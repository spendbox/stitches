# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" key (or the newer "secret" key). Keep it private. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random text (at least 32 characters). Used to sign login sessions.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
