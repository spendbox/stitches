# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" key (or the newer "secret" key). Keep it private. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random text (at least 32 characters). Used to sign login sessions.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Admin portal (/admin) ----
# The admin logs in with these. Use a strong password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-strong-password
# Optional: shown to trial users so they can reach you to pay.
# SUPPORT_PHONE is opened in WhatsApp (include the country code, e.g. +2348030000000).
SUPPORT_PHONE=
SUPPORT_EMAIL=

# ---- Site address ----
# Used for share links, link previews and search engines. Defaults to https://onepad.site
NEXT_PUBLIC_SITE_URL=https://onepad.site
